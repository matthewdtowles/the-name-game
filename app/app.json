{
  "expo": {
    "name": "Whose Name?",
    "slug": "the-name-game",
    "scheme": "thenamegame",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matthewdtowles.whosename",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:whosename.app"]
    },
    "android": {
      "package": "com.matthewdtowles.whosename",
      "adaptiveIcon": {
        "backgroundColor": "#211C36",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "whosename.app",
              "pathPrefix": "/j/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#211C36"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Whose Name? uses the camera to scan the code that joins a game.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9425d0f-236b-4a6e-be70-4d0ed8c083fe"
      }
    },
    "owner": "mtengineer"
  }
}
