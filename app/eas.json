{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GAME_SERVER_URL": "wss://play.staging.whosename.app",
        "EXPO_PUBLIC_WEB_URL": "https://staging.whosename.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_GAME_SERVER_URL": "wss://play.whosename.app",
        "EXPO_PUBLIC_WEB_URL": "https://whosename.app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    },
    "alpha": {
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "alpha"
      }
    }
  }
}
